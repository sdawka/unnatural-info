---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import catalog from '../data/references.json';
import { REFERENCE_CATEGORIES, normalizeReferenceSearch } from '../lib/references';
import '../styles/book.css';
const chapters = (await getCollection('chapters', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const categoryLabel = new Map(REFERENCE_CATEGORIES.map(category => [category.id as string, category.label]));
const entries = [...catalog].sort((a, b) => a.author.localeCompare(b.author, 'en') || a.title.localeCompare(b.title, 'en')).map(reference => ({
  ...reference,
  related: reference.chapters.map(id => {
    const chapter = chapters.find(chapter => chapter.id === id);
    if (!chapter) throw new Error(`Missing chapter ${id} for reference ${reference.id}`);
    return chapter;
  }),
  search: normalizeReferenceSearch([reference.author, reference.title, reference.influence, ...reference.tags.map(tag => categoryLabel.get(tag))].join(' ')),
}));
---
<BaseLayout title="References & influences" description="The works behind UNNATURAL, with notes on their place in the book. Browse by topic, search for an idea, or follow the references for a chapter." cinematic>
  <SiteHeader />
  <main id="main-content" class="book-page reading">
    <header class="reading__header">
      <p class="book-kicker">The company this book keeps</p>
      <h1 class="book-title">References &amp; influences</h1>
      <p class="book-lead">Some helped shape the book. Some give it something to argue with. Some are paths still worth exploring.</p>
      <p class="reading__intro">Browse the chapter references and wider reading suggestions below. Each note explains its connection to the book.</p>
    </header>

    <section class="reference-browser" aria-labelledby="browse-heading">
      <h2 id="browse-heading">Find a thread.</h2>
      <form class="reference-filters" id="reference-filters" hidden role="search" aria-label="Filter references">
        <div class="reference-filters__fields">
          <label for="reference-query">Search the references
            <input id="reference-query" name="q" type="search" placeholder="An author, a title, an idea…" autocomplete="off" aria-controls="reference-list" />
          </label>
          <label for="reference-chapter">Related chapter
            <select id="reference-chapter" name="chapter" aria-controls="reference-list">
              <option value="">The whole book</option>
              {chapters.map(chapter => <option value={chapter.id}>{chapter.data.chapterNumber ? `${chapter.data.chapterNumber}. ` : ''}{chapter.data.title}</option>)}
            </select>
          </label>
          <label for="reference-origin">Reading list
            <select id="reference-origin" name="source" aria-controls="reference-list">
              <option value="">Everything</option>
              <option value="chapter">Chapter references</option>
              <option value="suggestion">Wider suggestions</option>
            </select>
          </label>
        </div>
        <fieldset class="reference-categories" aria-describedby="category-help">
          <legend>Categories</legend>
          <p id="category-help">Choose any that interest you. Results can match any selected category.</p>
          <div class="reference-categories__options">
            {REFERENCE_CATEGORIES.map(category => <label><input type="checkbox" name="tag" value={category.id} aria-controls="reference-list" /><span>{category.label}</span></label>)}
          </div>
        </fieldset>
        <div class="reference-filters__footer">
          <p id="reference-count" role="status" aria-live="polite">{entries.length} references</p>
          <button type="reset">Clear filters</button>
        </div>
      </form>
      <p class="book-small" id="reference-fallback">All {entries.length} references are listed below. Use your browser’s Find command to look for an author, topic, or title.</p>
      <div class="reference-empty" id="reference-empty" hidden>
        <h3>No references match that combination.</h3>
        <p>Try a different word, choose fewer filters, or <button type="button" id="reference-reset-empty">show every reference</button>.</p>
      </div>
      <ul class="reference-list" id="reference-list">
        {entries.map(reference => <li class="reference" id={`ref-${reference.id}`} data-reference data-search={reference.search} data-tags={reference.tags.join(' ')} data-chapters={reference.chapters.join(' ')} data-origins={reference.origins.join(' ')}>
          <article aria-labelledby={`title-${reference.id}`}>
            <p class="reference__author">{reference.author}{reference.year != null && <span class="reference__year"> · {typeof reference.year === 'number' && reference.year < 0 ? `${Math.abs(reference.year)} BCE` : reference.year}</span>}</p>
            <h3 id={`title-${reference.id}`}><a href={`/reading#ref-${reference.id}`}>{reference.title}<span class="visually-hidden"> — link to this reference</span></a></h3>
            <ul class="reference__tags" aria-label="Topics">{reference.tags.map(tag => <li>{categoryLabel.get(tag)}</li>)}</ul>
            <p class="reference__influence"><span>{reference.origins.includes('chapter') ? 'Place in the book’s development' : reference.kind === 'reading-lead' ? 'Reading lead · why explore it' : 'Further reading · connection to the book'}</span>{reference.influence}</p>
            {reference.related.length > 0 && <p class="reference__chapters"><span>In the book:</span> {reference.related.map(chapter => <a href={`/chapters/${chapter.id}`} aria-label={chapter.data.chapterNumber ? `Chapter ${chapter.data.chapterNumber}: ${chapter.data.title}` : chapter.data.title} title={chapter.data.title}>{chapter.data.chapterNumber ? `Chapter ${chapter.data.chapterNumber}` : chapter.id === 'preface' ? 'Preface' : chapter.id === 'prologue' ? 'Prologue' : 'Epilogue'}</a>)}</p>}
          </article>
        </li>)}
      </ul>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { matchesReference, readReferenceFilters, writeReferenceFilters } from '../lib/references';
  const form = document.querySelector<HTMLFormElement>('#reference-filters');
  const query = document.querySelector<HTMLInputElement>('#reference-query');
  const chapter = document.querySelector<HTMLSelectElement>('#reference-chapter');
  const origin = document.querySelector<HTMLSelectElement>('#reference-origin');
  const count = document.querySelector<HTMLElement>('#reference-count');
  const empty = document.querySelector<HTMLElement>('#reference-empty');
  if (form && query && chapter && origin && count && empty) {
    const checkboxes = [...form.querySelectorAll<HTMLInputElement>('input[name="tag"]')];
    const chapterIds = [...chapter.options].map(option => option.value);
    const references = [...document.querySelectorAll<HTMLElement>('[data-reference]')].map(element => ({
      element,
      search: element.dataset.search ?? '',
      tags: (element.dataset.tags ?? '').split(' '),
      chapters: (element.dataset.chapters ?? '').split(' '),
      origins: (element.dataset.origins ?? '').split(' '),
    }));
    function apply(updateUrl = true) {
      const filters = { query: query!.value, categories: checkboxes.filter(input => input.checked).map(input => input.value), chapter: chapter!.value, origin: origin!.value };
      let visible = 0;
      for (const reference of references) {
        const matches = matchesReference(reference, filters);
        reference.element.hidden = !matches;
        if (matches) visible++;
      }
      count!.textContent = `${visible} of ${references.length} references`;
      empty!.hidden = visible !== 0;
      if (updateUrl) history.replaceState(null, '', writeReferenceFilters(new URL(location.href), filters));
    }
    function restoreFromUrl() {
      const filters = readReferenceFilters(new URLSearchParams(location.search), chapterIds);
      query!.value = filters.query;
      chapter!.value = filters.chapter;
      origin!.value = filters.origin;
      for (const input of checkboxes) input.checked = filters.categories.includes(input.value);
      apply(false);
    }
    restoreFromUrl();
    form.hidden = false;
    const fallback = document.querySelector<HTMLElement>('#reference-fallback');
    if (fallback) fallback.hidden = true;
    form.addEventListener('input', () => apply());
    form.addEventListener('submit', event => { event.preventDefault(); apply(); });
    form.addEventListener('reset', () => {
      query.value = '';
      chapter.value = '';
      origin.value = '';
      for (const input of checkboxes) input.checked = false;
      apply();
    });
    document.querySelector('#reference-reset-empty')?.addEventListener('click', () => { form.reset(); query.focus(); });
    window.addEventListener('popstate', restoreFromUrl);
  }
</script>

<style>
  .reading__header { max-width: 48rem; margin-bottom: var(--space-10); }
  .reading .book-title { max-width: 20ch; }
  .reading__intro { color: var(--color-ink-muted); max-width: 62ch; margin-top: var(--space-4); }
  .reference-browser > h2 { font: 380 var(--text-2xl)/1.2 var(--font-display); margin-bottom: var(--space-5); }
  .reference-filters { border-top: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule); padding: var(--space-6) 0; margin-bottom: var(--space-8); }
  .reference-filters__fields { display: grid; grid-template-columns: 1.2fr 1fr .8fr; gap: var(--space-6); }
  .reference-filters__fields label { display: grid; gap: var(--space-2); font-size: var(--text-sm); min-width: 0; }
  .reference-filters input[type="search"], .reference-filters select { display: block; width: 100%; min-width: 0; padding: .7rem .8rem; background: var(--color-ground-tint); color: var(--color-ink); border: 1px solid var(--color-rule); border-radius: 0; font: inherit; font-size: 1rem; }
  .reference-categories { border: 0; padding: 0; margin: var(--space-5) 0 0; min-width: 0; }
  .reference-categories legend { font-size: var(--text-sm); }
  .reference-categories > p { color: var(--color-ink-muted); font-size: var(--text-sm); margin: var(--space-1) 0 var(--space-3); }
  .reference-categories__options { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .reference-categories__options label { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem .7rem; border: 1px solid var(--color-rule); font-size: var(--text-sm); cursor: pointer; }
  .reference-categories__options label:has(input:checked) { color: var(--color-ink); border-color: var(--color-ink-muted); background: var(--color-ground-warm); }
  .reference-categories input { accent-color: var(--color-ink); width: 1rem; height: 1rem; flex: 0 0 auto; }
  .reference-filters__footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-5); font-size: var(--text-sm); color: var(--color-ink-muted); }
  .reference-filters button, .reference-empty button { border: 0; padding: .3rem 0; color: var(--color-ink); background: none; text-decoration: underline; text-underline-offset: .2em; cursor: pointer; font: inherit; }
  .reference-filters :is(input, select, button):focus-visible, .reference-empty button:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 4px; }
  .reference-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-10); list-style: none; padding: 0; }
  .reference { min-width: 0; border-top: 1px solid var(--color-rule); padding-top: var(--space-5); scroll-margin-top: var(--space-8); overflow-wrap: anywhere; }
  .reference:target { outline: 1px solid var(--color-ink-muted); outline-offset: var(--space-3); }
  .reference__author { font-size: var(--text-sm); color: var(--color-ink-soft); margin-bottom: var(--space-2); }
  .reference__year { color: var(--color-ink-muted); }
  .reference h3 { font: 380 var(--text-xl)/1.3 var(--font-display); }
  .reference h3 a:hover { text-decoration: underline; text-underline-offset: .2em; }
  .reference__tags { display: flex; flex-wrap: wrap; gap: .4rem .7rem; list-style: none; padding: 0; margin: var(--space-3) 0 var(--space-4); font: .7rem/1.6 var(--font-mono); color: var(--color-ink-muted); }
  .reference__tags li { border-bottom: 1px solid var(--color-rule); }
  .reference__influence { font-size: var(--text-base); color: var(--color-ink-soft); }
  .reference__influence > span { display: block; color: var(--color-ink-muted); font: .67rem/1.5 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; margin-bottom: var(--space-2); }
  .reference__chapters { display: flex; flex-wrap: wrap; gap: .4rem .8rem; margin-top: var(--space-4); font-size: var(--text-sm); }
  .reference__chapters > span { color: var(--color-ink-muted); }
  .reference__chapters a { text-decoration: underline; text-underline-offset: .2em; }
  .reference-empty { padding: var(--space-6) 0 var(--space-10); }
  .reference-empty h3 { font: 380 var(--text-xl)/1.3 var(--font-display); margin-bottom: var(--space-3); }
  [hidden] { display: none !important; }
  @media (max-width: 48rem) { .reference-filters__fields, .reference-list { grid-template-columns: 1fr; } }
</style>
