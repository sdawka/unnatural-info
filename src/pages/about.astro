---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const CONTACT_EMAIL = 'me@sahil.pro';
---

<BaseLayout
  title="About | UNNATURAL"
  description="About UNNATURAL: a working philosophical book about wanting, knowing, culture, technology, nature, and the shared worlds we build."
  cinematic
>
  <SiteHeader />
  <main id="main-content" class="ab">
    <div class="ab__container">

      <header class="ab__header">
        <p class="ab__kicker">
          <span class="ab__kicker-glyph" aria-hidden="true">§</span>
          About this work
        </p>
        <h1 class="ab__title">A book that leaves room to answer back.</h1>
        <p class="ab__lead">
          UNNATURAL is a book written in public. The chapters are working drafts: offered for reading, disagreement, and revision rather than as a system to join.
        </p>
      </header>

      <section class="ab__section">
        <h2 class="ab__heading">What it is</h2>
        <div class="ab__prose">
          <p>
            It begins with ordinary moments: doing something you did not quite choose, a label that helps and then pinches, a body interrupting a carefully made plan. From there it follows the larger arrangements those moments enter: families and workplaces, culture and institutions, technology and nature, shared knowledge and the rules that distribute room to move. UNNATURAL names a strange fact about being human: the natural body makes descriptions, plans, and rules that alter the world, while remaining part of that world.
          </p>
          <p>
            Its three acts are <em>What moves us</em> (<em>Volo Ergo Sum</em>), <em>How we make sense of things</em> (<code>init.d</code>), and <em>How we learn, create, and change</em> (<em>MMM</em>). They are lenses, not a ladder and not a diagnosis of anyone’s life.
          </p>
          <p>
            Read in order if you want the argument to accumulate. Or start with a chapter that catches your eye, try a small <a href="/practice">practice</a>, and return later. The <a href="/reading">reading page</a> names some of the conversations behind the book; the <a href="/wiki/">archive</a> keeps its working notes.
          </p>
        </div>
      </section>

      <section class="ab__section">
        <h2 class="ab__heading">Who</h2>
        <div class="ab__prose">
          <p>
            Written by Sahil Dawka. More at <a href="https://sahil.pro" rel="noopener">sahil.pro</a>.
          </p>
        </div>
      </section>

      <section class="ab__section">
        <h2 class="ab__heading">How it proceeds</h2>
        <div class="ab__prose">
          <p>
            The book starts from lived situations and brings them into contact with philosophy, science, history, technology, cultural practices, and other people’s reports. It treats experience as evidence of what a moment feels like, not as a private proof of how the world must be. A household routine, a bus timetable, a public rule, and a scientific model can all carry ideas into material consequences.
          </p>
          <p>
            It tries to keep three things separate: what happened, the story told about it, and what remains unknown. Evidence, correction, care, consent, fairness, and harm each deserve attention; no single framework settles them automatically.
          </p>
        </div>
      </section>

      <section class="ab__section">
        <h2 class="ab__heading">Reading a draft</h2>
        <div class="ab__prose">
          <p>
            “Working draft” means an argument may be incomplete, a source may need checking, or a better account may still be waiting. It does not mean the reader must agree, complete an exercise, or turn their own life into evidence for the book.
          </p>
        </div>
      </section>

      <section class="ab__section ab__section--contact">
        <h2 class="ab__heading">Contact</h2>
        <div class="ab__prose">
          <p>
            Notes, objections, corrections, and questions are all welcome. This is a working draft, and the argument gets sharper when it meets resistance.
          </p>
          <a class="ab__email" href={`mailto:${CONTACT_EMAIL}?subject=Unnatural`}>
            <span class="ab__email-label">Write</span>
            <span class="ab__email-addr">{CONTACT_EMAIL}</span>
            <span class="ab__email-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>

    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .ab {
    padding: clamp(var(--space-10), 7vw, var(--space-16)) var(--safe-right) var(--space-16) var(--safe-left);
  }

  .ab__container {
    max-width: var(--page-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .ab__header {
    max-width: 48rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-bottom: 1px dashed var(--color-rule);
  }

  .ab__kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-muted);
  }

  .ab__kicker-glyph {
    font-size: 1.2em;
    line-height: 1;
    color: var(--color-ink-faint);
  }

  .ab__title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 96, 'wght' 340, 'SOFT' 60;
    font-size: var(--text-4xl);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .ab__title { font-size: var(--text-5xl); }
  }

  .ab__lead {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 30, 'wght' 360, 'SOFT' 40;
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    max-width: 52ch;
    line-height: 1.5;
    margin-top: var(--space-2);
  }

  .ab__section {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-rule-soft);
  }

  .ab__section:last-child {
    border-bottom: none;
  }

  @media (min-width: 54rem) {
    .ab__section {
      grid-template-columns: 14rem 1fr;
      gap: var(--space-8);
    }
  }

  .ab__heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-muted);
    font-weight: 400;
    padding-top: 0.4em;
  }

  .ab__prose {
    max-width: 60ch;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--lh-body);
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ab__prose em {
    font-style: italic;
  }

  .ab__prose a {
    color: inherit;
    border-bottom: 1px solid var(--color-rule);
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }

  .ab__prose a:hover {
    border-bottom-color: var(--color-ink);
  }

  .ab__prose code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background-color: var(--color-ground-tint);
    padding: 0.05em 0.35em;
    border-radius: 2px;
  }

  /* Colophon */
  .ab__colophon {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 60ch;
  }

  .ab__colophon-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule-soft);
  }

  .ab__colophon-row:last-child {
    border-bottom: none;
  }

  .ab__colophon dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-muted);
    padding-top: 0.3em;
  }

  .ab__colophon dd {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-ink);
    line-height: 1.45;
  }

  .ab__colophon em {
    font-style: italic;
    font-variation-settings: 'opsz' 16, 'wght' 500;
  }

  @media (max-width: 36rem) {
    .ab__colophon-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .ab__colophon dt { padding-top: 0; }
  }

  /* Contact button */
  .ab__email {
    display: inline-grid;
    grid-template-columns: auto auto auto;
    align-items: baseline;
    gap: var(--space-3);
    min-height: var(--control-height, 48px);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-sm, 6px);
    border: 1px solid var(--color-rule);
    text-decoration: none !important;
    color: var(--color-ink);
    transition: border-color var(--dur-med) var(--ease-out), background-color var(--dur-med) var(--ease-out);
    background: color-mix(in srgb, var(--color-ground-tint) 30%, transparent);
    align-self: flex-start;
    border-bottom: 1px solid var(--color-rule) !important;
  }

  .ab__email:hover {
    border-color: var(--color-ink);
    background: var(--color-ground-tint);
  }

  .ab__email-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-muted);
  }

  .ab__email-addr {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-ink);
    letter-spacing: 0.01em;
  }

  .ab__email-arrow {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    transition: transform var(--dur-med) var(--ease-out), color var(--dur-fast);
  }

  .ab__email:hover .ab__email-arrow {
    color: var(--color-ink);
    transform: translateX(4px);
  }

  .ab__email:focus-visible { outline: 2px solid var(--color-focus, var(--color-ink)); outline-offset: 3px; }

  @media (max-width: 36rem) {
    .ab__email { width: 100%; grid-template-columns: auto 1fr auto; }
    .ab__email-addr { min-width: 0; overflow-wrap: anywhere; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ab__prose a, .ab__email, .ab__email-arrow { transition: none; }
  }
</style>
