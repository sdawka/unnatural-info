---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ResumeReading from '../components/ResumeReading.astro';
import { ACTS, BOOK_DESCRIPTION } from '../lib/book';
import '../styles/book.css';
---
<BaseLayout title="UNNATURAL" description={BOOK_DESCRIPTION} cinematic>
  <SiteHeader />
  <main class="book-page" id="main-content">
    <section class="opening" aria-labelledby="opening-title">
      <div>
        <p class="book-kicker">An online book · Philosophy in ordinary life</p>
        <h1 class="book-title" id="opening-title">A message.<br />No reply.<br /><em>A whole world.</em></h1>
        <p class="book-lead">The screen hasn't changed. Your explanation has changed three times.</p>
        <div class="book-actions">
          <a class="book-button" href="/chapters/prologue">Begin with the silence →</a>
          <a class="book-link" href="/explore">See the book</a>
        </div>
        <ResumeReading />
      </div>
      <aside class="invitation" aria-label="An imagined invitation">
        <p class="book-kicker">Friday, 6:04 pm</p>
        <blockquote>“Dinner at mine next week?”</blockquote>
        <p class="invitation__silence" aria-hidden="true">· &nbsp; · &nbsp; ·</p>
        <p>Busy. Annoyed. Never liked you.<br />Or perhaps the phone is in another room.</p>
        <details>
          <summary>What do you actually know?</summary>
          <p>An invitation was sent. A reply has not arrived. The rest may be possible. It is still a story.</p>
          <a class="book-link" href="/practice/notebook">Try this with a moment of your own →</a>
        </details>
      </aside>
    </section>
    <section class="book-section" aria-labelledby="book-about">
      <p class="book-kicker">The familiar, made strange</p>
      <h2 id="book-about">How much of your world<br />did you quietly help make?</h2>
      <div class="book-copy">
        <p>UNNATURAL follows that question from a private wish to a shared world. We meet a label that sticks, a plan that fails, a meal that becomes something nobody quite intended.</p>
        <p>Along the way, you can practise noticing what moves you, questioning the accounts you live by, and choosing what to do with them. Some questions lead to an experiment. Some ask you to stay a little longer.</p>
        <p>No philosophy background needed. This is a book in progress, with short working drafts and optional exercises. You are welcome to argue with it.</p>
      </div>
    </section>
    <section class="book-section" aria-labelledby="journey-title">
      <h2 id="journey-title">One question opens another.</h2>
      <ol class="book-acts">
        {ACTS.map(act => <li><a class="book-act" href={`/acts/${act.key}`} style={`--act-color: ${act.color}`}>
          <span class="book-act__num" aria-hidden="true">{act.roman}</span>
          <div><h3>{act.name}</h3><p>{act.premise}</p><small>Enter Act {act.roman} →</small></div>
        </a></li>)}
      </ol>
    </section>
    <section class="book-section">
      <h2>You can start with something small.</h2>
      <p>A disagreement, a description of yourself, or a choice you keep putting off. Bring one along. See whether it looks different by the time you leave.</p>
      <div class="book-actions"><a class="book-button" href="/chapters/prologue">Start reading →</a><a class="book-link" href="/practice">Explore the exercises</a></div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .opening { display: grid; grid-template-columns: 1.35fr 1fr; gap: var(--space-12); align-items: center; padding: var(--space-8) 0 var(--space-12); }
  .opening .book-title { font-size: clamp(3.3rem, 7vw, 6rem); }
  .opening em { color: var(--color-act-i); font-weight: inherit; }
  .opening .book-lead { max-width: 28ch; font-size: var(--text-lg); }
  .invitation { border-top: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule); padding: var(--space-8) 0; transform: rotate(-1deg); }
  .invitation blockquote { font: 350 clamp(1.6rem, 3vw, 2.2rem)/1.35 var(--font-display); }
  .invitation > p:not(.book-kicker) { color: var(--color-ink-muted); font-size: var(--text-base); }
  .invitation__silence { margin: var(--space-8) 0; }
  .invitation details { font-size: var(--text-sm); }
  .invitation summary { color: var(--color-act-ii); }
  @media (max-width: 48rem) { .opening { grid-template-columns: 1fr; gap: var(--space-10); padding-top: 0; } .invitation { max-width: 30rem; transform: none; } }
</style>
