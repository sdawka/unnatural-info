---
import BaseLayout from "../layouts/BaseLayout.astro";

const questions = [
  "Have you ever wondered what you are?",
  "What is the thing that wonders?",
  "What are you, really?",
];
---

<BaseLayout title="UNNATURAL" cinematic>
  <main class="landing" id="landing">
    <div class="landing__content">
      <!-- Slide 1: Question + Progress -->
      <div class="landing__slide" id="slide-question">
        <p class="landing__question" id="question"></p>
        <div class="landing__progress" id="progress">
          <div class="landing__progress-fill"></div>
        </div>
      </div>

      <!-- Slide 2: Title (UNNATURAL INFORMATION together) -->
      <div class="landing__slide" id="slide-title">
        <p class="landing__question-echo" id="question-echo"></p>
        <div class="landing__title-unified">
          <span class="landing__word">UNNATURAL</span>
          <span class="landing__word">INFORMATION</span>
        </div>
      </div>

      <!-- Slide 3: Separated with Because sentences -->
      <div class="landing__slide" id="slide-separated">
        <p class="landing__question-echo">&nbsp;</p>
        <div class="landing__title-separated">
          <div class="landing__word-group">
            <span class="landing__word">UNNATURAL</span>
            <p class="landing__because" id="because-1">
              Because you have free admin access to the information realm.
            </p>
          </div>
          <div class="landing__word-group">
            <span class="landing__word">INFORMATION</span>
            <p class="landing__because" id="because-2">
              Because the part that can know itself lives in pattern in substrate.
            </p>
          </div>
        </div>
        <a href="/explore" class="landing__enter" id="enter">ENTER</a>
      </div>
    </div>
  </main>

  <script define:vars={{ questions }}>
    const question = questions[Math.floor(Math.random() * questions.length)];
    document.getElementById('question').textContent = question;
    document.querySelectorAll('.landing__question-echo').forEach(el => {
      if (el.textContent.trim()) el.textContent = question.toUpperCase();
    });
    document.getElementById('question-echo').textContent = question.toUpperCase();
  </script>
</BaseLayout>

<style>
  .landing {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8);
    overflow: hidden;
  }

  .landing__content {
    text-align: center;
    max-width: 40rem;
    position: relative;
  }

  /* Slides - only one visible at a time */
  .landing__slide {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    view-transition-name: slide;
  }

  .landing__slide.active {
    display: flex;
  }

  /* Question */
  .landing__question {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 36, "wght" 340, "SOFT" 60;
    font-style: italic;
    font-size: clamp(1.5rem, 5vw, 2rem);
    color: var(--color-ink);
    margin: 0 0 var(--space-10);
  }

  .landing__progress {
    width: 160px;
    height: 2px;
    background: var(--color-rule);
    overflow: hidden;
  }

  .landing__progress-fill {
    height: 100%;
    width: 0;
    background: var(--color-ink-faint);
    animation: fillProgress 2.5s linear forwards;
  }

  /* Echo question (shrunk, in later slides) */
  .landing__question-echo {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    color: var(--color-ink-ghost);
    margin: 0 0 var(--space-12);
    min-height: 1.2em;
  }

  /* Title unified (slide 2) */
  .landing__title-unified {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  /* Title separated (slide 3) */
  .landing__title-separated {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
  }

  .landing__word-group {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .landing__word {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 72, "wght" var(--title-weight, 300), "SOFT" 40;
    font-size: clamp(2.8rem, 14vw, 4.5rem);
    letter-spacing: var(--title-tracking, 0.32em);
    color: var(--color-ink);
    line-height: 1;
  }

  .landing__because {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.75rem, 2.5vw, 0.95rem);
    color: var(--color-ink-faint);
    letter-spacing: 0.02em;
    margin: var(--space-4) 0 0 0;
    max-width: 30rem;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 1000ms cubic-bezier(0.22, 0.6, 0.36, 1),
                transform 1000ms cubic-bezier(0.22, 0.6, 0.36, 1);
  }

  .landing__because.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .landing__enter {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    color: var(--color-ink-faint);
    text-decoration: none;
    margin-top: var(--space-16);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 900ms cubic-bezier(0.22, 0.6, 0.36, 1),
                transform 900ms cubic-bezier(0.22, 0.6, 0.36, 1),
                color var(--dur-fast);
  }

  .landing__enter.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .landing__enter:hover {
    color: var(--color-ink);
  }

  @keyframes fillProgress {
    to { width: 100%; }
  }

  /* View Transition: cinematic crossfade - slow and deliberate */
  ::view-transition-old(slide) {
    animation: fade-out 1200ms cubic-bezier(0.22, 0.6, 0.36, 1) forwards;
  }

  ::view-transition-new(slide) {
    animation: fade-in 1200ms cubic-bezier(0.22, 0.6, 0.36, 1) forwards;
  }

  @keyframes fade-out {
    0% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    40% {
      opacity: 0.6;
    }
    100% {
      opacity: 0;
      transform: scale(0.99) translateY(-15px);
    }
  }

  @keyframes fade-in {
    0% {
      opacity: 0;
      transform: scale(0.99) translateY(15px);
    }
    60% {
      opacity: 0.8;
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Ensure view transition group is positioned correctly */
  ::view-transition-group(slide) {
    animation-duration: 1200ms;
    animation-timing-function: cubic-bezier(0.22, 0.6, 0.36, 1);
  }

  ::view-transition-image-pair(slide) {
    isolation: isolate;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(slide),
    ::view-transition-new(slide) {
      animation: none;
    }
  }
</style>

<script>
  const slideQuestion = document.getElementById('slide-question');
  const slideTitle = document.getElementById('slide-title');
  const slideSeparated = document.getElementById('slide-separated');
  const because1 = document.getElementById('because-1');
  const because2 = document.getElementById('because-2');
  const enter = document.getElementById('enter');

  let stage = 0;

  // Start with question slide
  slideQuestion.classList.add('active');

  async function transitionTo(fromSlide, toSlide) {
    if (document.startViewTransition) {
      await document.startViewTransition(() => {
        fromSlide.classList.remove('active');
        toSlide.classList.add('active');
      }).finished;
    } else {
      fromSlide.classList.remove('active');
      toSlide.classList.add('active');
    }
  }

  async function advanceToTitle() {
    if (stage !== 0) return;
    stage = 1;

    await transitionTo(slideQuestion, slideTitle);

    // Wait, then advance to separated
    setTimeout(advanceToSeparated, 1800);
  }

  async function advanceToSeparated() {
    if (stage !== 1) return;
    stage = 2;

    await transitionTo(slideTitle, slideSeparated);

    // Reveal because sentences and enter with generous staggered timing
    setTimeout(() => because1.classList.add('visible'), 600);
    setTimeout(() => because2.classList.add('visible'), 1500);
    setTimeout(() => enter.classList.add('visible'), 2400);
  }

  function skipToEnd() {
    if (stage === 2) return;
    stage = 2;

    // Instant switch to final slide
    slideQuestion.classList.remove('active');
    slideTitle.classList.remove('active');
    slideSeparated.classList.add('active');

    // Quick staggered reveal
    setTimeout(() => because1.classList.add('visible'), 150);
    setTimeout(() => because2.classList.add('visible'), 300);
    setTimeout(() => enter.classList.add('visible'), 450);
  }

  // Auto-advance after progress (2.5s)
  setTimeout(advanceToTitle, 2500);

  // Skip on interaction
  document.addEventListener('click', skipToEnd);
  document.addEventListener('keydown', skipToEnd);

  // TODO: PostHog integration
</script>
