---
import BaseLayout from "../layouts/BaseLayout.astro";

const questions = [
  "Have you ever wondered what you are?",
  "What is the thing that wonders?",
  "What are you, really?",
];
---

<BaseLayout title="UNNATURAL" cinematic>
  <main class="landing" id="landing">
    <div class="landing__content">
      <!-- Slide 1: Question + Progress -->
      <div class="landing__slide landing__slide--question" id="slide-question">
        <p class="landing__question" id="question"></p>
        <div class="landing__progress" id="progress">
          <div class="landing__progress-fill"></div>
        </div>
      </div>

      <!-- Slide 2: Title (UNNATURAL INFORMATION together) -->
      <div class="landing__slide landing__slide--title" id="slide-title">
        <p class="landing__question-shrunk" id="question-shrunk"></p>
        <div class="landing__title-unified" id="title-unified">
          <span class="landing__word">UNNATURAL</span>
          <span class="landing__word">INFORMATION</span>
        </div>
      </div>

      <!-- Slide 3: Separated with Because sentences -->
      <div class="landing__slide landing__slide--separated" id="slide-separated">
        <p class="landing__question-shrunk">&nbsp;</p>
        <div class="landing__title-separated" id="title-separated">
          <div class="landing__word-group" id="group-unnatural">
            <span class="landing__word">UNNATURAL</span>
            <p class="landing__because" id="because-1">
              Because you have free admin access to the information realm.
            </p>
          </div>
          <div class="landing__word-group" id="group-information">
            <span class="landing__word">INFORMATION</span>
            <p class="landing__because" id="because-2">
              Because the part that can know itself lives in pattern in substrate.
            </p>
          </div>
        </div>
        <a href="/explore" class="landing__enter" id="enter">ENTER</a>
      </div>
    </div>
  </main>

  <script define:vars={{ questions }}>
    const question = questions[Math.floor(Math.random() * questions.length)];
    document.getElementById('question').textContent = question;
    document.querySelectorAll('.landing__question-shrunk').forEach(el => {
      el.textContent = question.toUpperCase();
    });
  </script>
</BaseLayout>

<style>
  .landing {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8);
    overflow: hidden;
  }

  .landing__content {
    text-align: center;
    max-width: 40rem;
    position: relative;
  }

  /* Slides */
  .landing__slide {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .landing__slide.active {
    display: flex;
  }

  /* Slide 1: Question */
  .landing__slide--question {
    view-transition-name: question-slide;
  }

  .landing__question {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 36, "wght" 340, "SOFT" 60;
    font-style: italic;
    font-size: clamp(1.5rem, 5vw, 2rem);
    color: var(--color-ink);
    margin: 0 0 var(--space-10);
  }

  .landing__progress {
    width: 160px;
    height: 2px;
    background: var(--color-rule);
    overflow: hidden;
  }

  .landing__progress-fill {
    height: 100%;
    width: 0;
    background: var(--color-ink-faint);
    animation: fillProgress 2.5s linear forwards;
  }

  /* Slide 2: Title unified */
  .landing__slide--title {
    view-transition-name: title-slide;
  }

  .landing__question-shrunk {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    color: var(--color-ink-ghost);
    margin: 0 0 var(--space-12);
    min-height: 1em;
  }

  .landing__title-unified {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  /* Slide 3: Separated */
  .landing__slide--separated {
    view-transition-name: separated-slide;
  }

  .landing__title-separated {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
  }

  .landing__word-group {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .landing__word {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 72, "wght" var(--title-weight, 300), "SOFT" 40;
    font-size: clamp(2.8rem, 14vw, 4.5rem);
    letter-spacing: var(--title-tracking, 0.32em);
    color: var(--color-ink);
    line-height: 1;
  }

  .landing__because {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.75rem, 2.5vw, 0.95rem);
    color: var(--color-ink-faint);
    letter-spacing: 0.02em;
    margin: var(--space-4) 0 0 0;
    max-width: 30rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 600ms ease-out, transform 600ms ease-out;
  }

  .landing__because.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .landing__enter {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    color: var(--color-ink-faint);
    text-decoration: none;
    margin-top: var(--space-16);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 500ms ease-out, transform 500ms ease-out, color var(--dur-fast);
  }

  .landing__enter.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .landing__enter:hover {
    color: var(--color-ink);
  }

  @keyframes fillProgress {
    to { width: 100%; }
  }

  /* View Transition animations */
  @keyframes slide-out-up {
    from { opacity: 1; transform: translateY(0) scale(1); }
    to { opacity: 0; transform: translateY(-30px) scale(0.95); }
  }

  @keyframes slide-in-up {
    from { opacity: 0; transform: translateY(30px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes crossfade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes crossfade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Apply to view transitions */
  ::view-transition-old(question-slide),
  ::view-transition-old(title-slide) {
    animation: slide-out-up 600ms ease-out forwards;
  }

  ::view-transition-new(title-slide),
  ::view-transition-new(separated-slide) {
    animation: slide-in-up 600ms ease-out forwards;
  }

  /* Fallback for no view transitions */
  @supports not (view-transition-name: none) {
    .landing__slide {
      transition: opacity 500ms ease-out;
    }
  }
</style>

<script>
  const slideQuestion = document.getElementById('slide-question');
  const slideTitle = document.getElementById('slide-title');
  const slideSeparated = document.getElementById('slide-separated');
  const because1 = document.getElementById('because-1');
  const because2 = document.getElementById('because-2');
  const enter = document.getElementById('enter');

  let stage = 0; // 0 = question, 1 = title, 2 = separated

  // Start with question slide visible
  slideQuestion.classList.add('active');

  function transition(fromSlide, toSlide, callback) {
    if (document.startViewTransition) {
      document.startViewTransition(() => {
        fromSlide.classList.remove('active');
        toSlide.classList.add('active');
        if (callback) callback();
      });
    } else {
      // Fallback without view transitions
      fromSlide.style.opacity = '0';
      setTimeout(() => {
        fromSlide.classList.remove('active');
        fromSlide.style.opacity = '';
        toSlide.classList.add('active');
        if (callback) callback();
      }, 500);
    }
  }

  function advanceToTitle() {
    if (stage !== 0) return;
    stage = 1;

    transition(slideQuestion, slideTitle, () => {
      // After transition, wait then advance to separated
      setTimeout(advanceToSeparated, 1200);
    });
  }

  function advanceToSeparated() {
    if (stage !== 1) return;
    stage = 2;

    transition(slideTitle, slideSeparated, () => {
      // Animate in the because sentences and enter
      setTimeout(() => because1.classList.add('visible'), 400);
      setTimeout(() => because2.classList.add('visible'), 1000);
      setTimeout(() => enter.classList.add('visible'), 1600);
    });
  }

  function skipToEnd() {
    if (stage === 2) return;

    // Skip directly to final state
    slideQuestion.classList.remove('active');
    slideTitle.classList.remove('active');
    slideSeparated.classList.add('active');
    stage = 2;

    // Quick reveal of all elements
    setTimeout(() => because1.classList.add('visible'), 100);
    setTimeout(() => because2.classList.add('visible'), 200);
    setTimeout(() => enter.classList.add('visible'), 300);
  }

  // Auto-advance after progress bar (2.5s)
  setTimeout(advanceToTitle, 2500);

  // Skip on interaction
  document.addEventListener('click', skipToEnd);
  document.addEventListener('keydown', skipToEnd);

  // TODO: PostHog integration for A/B tracking of questions
  // window.posthog?.capture('landing_question_shown', { question });
</script>
