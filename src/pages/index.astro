---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ResumeReading from '../components/ResumeReading.astro';
import { ACTS, BOOK_DESCRIPTION, READING_PATHS } from '../lib/book';
import '../styles/book.css';
const chapters = await getCollection('chapters', ({ data }) => !data.draft);
const paths = READING_PATHS.map(path => {
  const entry = chapters.find(chapter => chapter.data.chapterNumber === path.chapters[0]);
  if (!entry) throw new Error(`Missing entry chapter for reading path: ${path.id}`);
  return { ...path, entry };
});
---
<BaseLayout title="UNNATURAL" description={BOOK_DESCRIPTION} cinematic>
  <SiteHeader />
  <main class="book-page" id="main-content">
    <header class="opening" aria-labelledby="opening-title">
      <p class="book-kicker">An online book · Philosophy for the rest of us</p>
      <h1 class="book-title" id="opening-title">Life doesn’t always make sense.<br /><em>Even when it should.</em></h1>
      <p class="book-lead">A journey through what moves us, how we know, and how our ideas shape the world. From a private thought to a public rule, a living body to a civilization.</p>
      <div class="book-actions"><a class="book-button" href="/chapters/prologue">Begin the book →</a><a class="book-link" href="/explore">See what’s inside</a></div>
      <ResumeReading />
    </header>
    <section class="recognitions" aria-labelledby="recognition-heading">
      <h2 id="recognition-heading">Which of these feels familiar?</h2>
      <p class="book-small">Open one that catches you. More than one is allowed.</p>
      <div class="recognitions__grid">
        {paths.map(path => <details id={`opening-${path.id}`}>
          <summary>{path.title}</summary>
          <div class="recognitions__body">
            <p>{path.scene}</p>
            <p>{path.question}</p>
            <div class="recognitions__links">
              <a class="book-link" href={`/chapters/${path.entry.id}`}>Begin with Chapter {path.entry.data.chapterNumber} →</a>
              <a class="book-link" href={`/explore#path-${path.id}`}>Follow this thread →</a>
            </div>
          </div>
        </details>)}
      </div>
    </section>
    <section class="book-section" aria-labelledby="book-about">
      <p class="book-kicker">Why “unnatural”?</p>
      <h2 id="book-about">Nature has started<br />making plans.</h2>
      <div class="book-copy">
        <p>We are made of the same world as everything else. Somehow we also make pictures of it: a shopping list, an idea of who we are, a rule about who owns the land.</p>
        <p>Then those pictures get to work. A recipe becomes a meal. A drawing becomes a bridge. A rule becomes a fence. People born long after the rule was written find themselves living on one side of it.</p>
        <p>This book follows that curious arrangement from wanting, through the distinctions we make, into the cultures, tools, and institutions we build. It asks what we can know, what is worth changing, and how a creature that belongs to nature comes to feel outside it.</p>
        <p>There is a great deal to wonder about before anyone needs a grand theory. We will probably attempt one anyway.</p>
        <p>No philosophy background needed. The chapters use ordinary examples, room for disagreement, and small experiments with the ideas themselves. It is a book in progress. So, with rather less paperwork, are we.</p>
      </div>
    </section>
    <section class="book-section" aria-labelledby="journey-title">
      <h2 id="journey-title">One question opens another.</h2>
      <ol class="book-acts">{ACTS.map(act => <li><a class="book-act" href={`/acts/${act.key}`} style={`--act-color: ${act.color}`}><span class="book-act__num" aria-hidden="true">{act.roman}</span><div><h3>{act.name}</h3><p>{act.premise}</p><small>Enter Act {act.roman} →</small></div></a></li>)}</ol>
    </section>
    <section class="book-section">
      <h2>Put an idea within reach.</h2>
      <p>Notice a want before explaining it. Follow a timetable from marks on paper to people moving through a city. Change a rule and inspect what it makes possible. Each exercise starts with a particular question from the book.</p>
      <div class="book-actions"><a class="book-button" href="/chapters/prologue">Start reading →</a><a class="book-link" href="/practice">Try an idea →</a></div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .opening { padding-bottom: var(--space-8); }
  .opening .book-title { font-size: clamp(2.5rem, 5vw, 4rem); max-width: 24ch; }
  .opening em { color: var(--color-act-i); font-weight: inherit; }
  .opening .book-lead { max-width: 64ch; font-size: var(--text-lg); margin: var(--space-5) 0; }
  .opening .book-actions { margin: var(--space-5) 0 0; }
  .recognitions h2 { font: 380 var(--text-xl)/1.3 var(--font-display); margin-bottom: var(--space-3); }
  .recognitions > p { margin-bottom: var(--space-5); }
  .recognitions__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-10); align-items: start; }
  .recognitions details { border-top: 1px solid var(--color-rule); margin: 0; min-width: 0; }
  .recognitions summary { padding: var(--space-5) 0; font: 380 var(--text-xl)/1.35 var(--font-display); }
  .recognitions summary:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 4px; }
  .recognitions details[open] > summary { margin-bottom: 0; }
  .recognitions__body { padding-bottom: var(--space-6); font-size: var(--text-base); color: var(--color-ink-muted); }
  .recognitions__body p + p { margin-top: 1em; }
  .recognitions__links { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); margin-top: var(--space-5); font-size: var(--text-sm); }
  @media (max-width: 48rem) {
    .opening .book-title { max-width: 24ch; }
    .opening .book-lead { font-size: var(--text-base); }
    .recognitions__grid { grid-template-columns: 1fr; }
    .recognitions summary { font-size: var(--text-lg); }
  }
</style>
