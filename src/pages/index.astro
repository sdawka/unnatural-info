---
import BaseLayout from "../layouts/BaseLayout.astro";

const questions = [
  "Have you ever wondered what you are?",
  "What is the thing that wonders?",
  "What are you, really?",
];
---

<BaseLayout title="UNNATURAL" cinematic>
  <main class="landing">
    <div class="landing__content">
      <!-- Question (visible initially) -->
      <p class="landing__question" id="question"></p>

      <!-- Progress line -->
      <div class="landing__progress" id="progress">
        <div class="landing__progress-fill"></div>
      </div>

      <!-- Reveal container (hidden initially) -->
      <div class="landing__reveal" id="reveal">
        <p class="landing__question-shrunk" id="question-shrunk"></p>

        <div class="landing__title" id="title">
          <span class="landing__word" id="word-unnatural">UNNATURAL</span>
          <span class="landing__word" id="word-information">INFORMATION</span>
        </div>

        <p class="landing__because landing__because--first" id="because-1">
          Because you have free admin access to the information realm.
        </p>

        <p class="landing__because landing__because--second" id="because-2">
          Because the part that can know itself lives in pattern in substrate.
        </p>

        <a href="/explore" class="landing__enter" id="enter">ENTER</a>
      </div>
    </div>
  </main>

  <script define:vars={{ questions }}>
    const question = questions[Math.floor(Math.random() * questions.length)];
    document.getElementById('question').textContent = question;
    document.getElementById('question-shrunk').textContent = question.toUpperCase();
  </script>
</BaseLayout>

<style>
  .landing {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8);
  }

  .landing__content {
    text-align: center;
    max-width: 28rem;
  }

  /* Question - initial state */
  .landing__question {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 36, "wght" 340, "SOFT" 60;
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-ink);
    margin: 0 0 var(--space-8);
    opacity: 0;
    animation: fadeIn var(--anim-fade) forwards;
  }

  /* Progress line */
  .landing__progress {
    width: 120px;
    height: 2px;
    background: var(--color-rule);
    margin: 0 auto;
    overflow: hidden;
  }

  .landing__progress-fill {
    height: 100%;
    width: 0;
    background: var(--color-ink-faint);
    animation: fillProgress 2.5s linear forwards;
  }

  /* Reveal container - hidden initially */
  .landing__reveal {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .landing__reveal.active {
    display: flex;
  }

  /* Shrunk question */
  .landing__question-shrunk {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.2em;
    color: var(--color-ink-ghost);
    margin: 0 0 var(--space-10);
    opacity: 0;
  }

  /* Title words */
  .landing__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin-bottom: 0;
  }

  .landing__word {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 72, "wght" var(--title-weight, 300), "SOFT" 40;
    font-size: clamp(1.8rem, 8vw, 2.2rem);
    letter-spacing: var(--title-tracking, 0.32em);
    color: var(--color-ink);
    opacity: 0;
  }

  /* Because sentences */
  .landing__because {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.65rem;
    color: var(--color-ink-faint);
    letter-spacing: 0.02em;
    margin: 0;
    opacity: 0;
    max-width: 24rem;
  }

  .landing__because--first {
    margin-top: var(--space-2);
  }

  .landing__because--second {
    margin-top: var(--space-6);
  }

  /* Enter link */
  .landing__enter {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.4em;
    color: var(--color-ink-faint);
    text-decoration: none;
    margin-top: var(--space-10);
    opacity: 0;
    transition: color var(--dur-fast);
  }

  .landing__enter:hover {
    color: var(--color-ink);
  }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  @keyframes fillProgress {
    to { width: 100%; }
  }

  /* Hide question and progress after reveal */
  .landing.revealed .landing__question,
  .landing.revealed .landing__progress {
    display: none;
  }
</style>

<script>
  const landing = document.querySelector('.landing');
  const questionEl = document.getElementById('question');
  const progressEl = document.getElementById('progress');
  const revealEl = document.getElementById('reveal');
  const questionShrunk = document.getElementById('question-shrunk');
  const wordUnnatural = document.getElementById('word-unnatural');
  const wordInformation = document.getElementById('word-information');
  const because1 = document.getElementById('because-1');
  const because2 = document.getElementById('because-2');
  const enter = document.getElementById('enter');

  let revealed = false;

  function reveal() {
    if (revealed) return;
    revealed = true;

    // Hide question and progress
    questionEl.style.display = 'none';
    progressEl.style.display = 'none';

    // Show reveal container
    revealEl.classList.add('active');

    // Animation sequence
    const animate = (el, delay) => {
      setTimeout(() => {
        el.style.transition = 'opacity 300ms ease-out';
        el.style.opacity = '1';
      }, delay);
    };

    // 0ms - Question shrinks up
    animate(questionShrunk, 0);

    // 200ms - UNNATURAL INFORMATION together
    setTimeout(() => {
      wordUnnatural.style.transition = 'opacity 400ms ease-out';
      wordUnnatural.style.opacity = '1';
      wordInformation.style.transition = 'opacity 400ms ease-out';
      wordInformation.style.opacity = '1';
    }, 200);

    // 800ms - Words separate (add gap)
    setTimeout(() => {
      const title = document.querySelector('.landing__title');
      title.style.transition = 'gap 400ms ease-out';
      title.style.gap = 'var(--space-6)';
    }, 800);

    // 1200ms - First because
    animate(because1, 1200);

    // 1600ms - Second because
    animate(because2, 1600);

    // 2000ms - Enter
    animate(enter, 2000);
  }

  // Auto-reveal after progress completes (2.5s)
  setTimeout(reveal, 2500);

  // Skip on click or scroll
  document.addEventListener('click', reveal);
  document.addEventListener('scroll', reveal);
  document.addEventListener('keydown', reveal);

  // TODO: PostHog integration for A/B tracking of questions
  // window.posthog?.capture('landing_question_shown', { question });
</script>
