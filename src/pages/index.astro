---
import BaseLayout from "../layouts/BaseLayout.astro";

const questions = [
  "Have you ever wondered what you are?",
  "What is the thing that wonders?",
  "What are you, really?",
];
---

<BaseLayout title="UNNATURAL" cinematic>
  <main class="landing">
    <div class="landing__content">
      <!-- Question (visible initially) -->
      <p class="landing__question" id="question"></p>

      <!-- Progress line -->
      <div class="landing__progress" id="progress">
        <div class="landing__progress-fill"></div>
      </div>

      <!-- Reveal container (hidden initially) -->
      <div class="landing__reveal" id="reveal">
        <p class="landing__question-shrunk" id="question-shrunk"></p>

        <div class="landing__title" id="title">
          <!-- UNNATURAL + its because -->
          <div class="landing__word-group" id="group-unnatural">
            <span class="landing__word">UNNATURAL</span>
            <p class="landing__because" id="because-1">
              Because you have free admin access to the information realm.
            </p>
          </div>

          <!-- INFORMATION + its because -->
          <div class="landing__word-group" id="group-information">
            <span class="landing__word">INFORMATION</span>
            <p class="landing__because" id="because-2">
              Because the part that can know itself lives in pattern in substrate.
            </p>
          </div>
        </div>

        <a href="/explore" class="landing__enter" id="enter">ENTER</a>
      </div>
    </div>
  </main>

  <script define:vars={{ questions }}>
    const question = questions[Math.floor(Math.random() * questions.length)];
    document.getElementById('question').textContent = question;
    document.getElementById('question-shrunk').textContent = question.toUpperCase();
  </script>
</BaseLayout>

<style>
  .landing {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8);
  }

  .landing__content {
    text-align: center;
    max-width: 36rem;
  }

  /* Question - initial state */
  .landing__question {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 36, "wght" 340, "SOFT" 60;
    font-style: italic;
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    color: var(--color-ink);
    margin: 0 0 var(--space-10);
    opacity: 0;
    animation: fadeIn var(--anim-fade) forwards;
  }

  /* Progress line */
  .landing__progress {
    width: 140px;
    height: 2px;
    background: var(--color-rule);
    margin: 0 auto;
    overflow: hidden;
  }

  .landing__progress-fill {
    height: 100%;
    width: 0;
    background: var(--color-ink-faint);
    animation: fillProgress 2.5s linear forwards;
  }

  /* Reveal container - hidden initially */
  .landing__reveal {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .landing__reveal.active {
    display: flex;
  }

  /* Shrunk question */
  .landing__question-shrunk {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: var(--color-ink-ghost);
    margin: 0 0 var(--space-12);
    opacity: 0;
  }

  /* Title container */
  .landing__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* Word group (word + its because) */
  .landing__word-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
  }

  .landing__word {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 72, "wght" var(--title-weight, 300), "SOFT" 40;
    font-size: clamp(2.5rem, 12vw, 4rem);
    letter-spacing: var(--title-tracking, 0.32em);
    color: var(--color-ink);
    line-height: 1;
  }

  /* Because sentences */
  .landing__because {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.7rem, 2vw, 0.85rem);
    color: var(--color-ink-faint);
    letter-spacing: 0.02em;
    margin: var(--space-3) 0 0 0;
    max-width: 28rem;
    opacity: 0;
  }

  /* Enter link */
  .landing__enter {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    color: var(--color-ink-faint);
    text-decoration: none;
    margin-top: var(--space-16);
    opacity: 0;
    transition: color var(--dur-fast);
  }

  .landing__enter:hover {
    color: var(--color-ink);
  }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  @keyframes fillProgress {
    to { width: 100%; }
  }

  /* Hide question and progress after reveal */
  .landing.revealed .landing__question,
  .landing.revealed .landing__progress {
    display: none;
  }
</style>

<script>
  const questionEl = document.getElementById('question');
  const progressEl = document.getElementById('progress');
  const revealEl = document.getElementById('reveal');
  const questionShrunk = document.getElementById('question-shrunk');
  const groupUnnatural = document.getElementById('group-unnatural');
  const groupInformation = document.getElementById('group-information');
  const because1 = document.getElementById('because-1');
  const because2 = document.getElementById('because-2');
  const enter = document.getElementById('enter');
  const title = document.getElementById('title');

  let revealed = false;

  function reveal() {
    if (revealed) return;
    revealed = true;

    // Hide question and progress
    questionEl.style.display = 'none';
    progressEl.style.display = 'none';

    // Show reveal container
    revealEl.classList.add('active');

    // Animation sequence - slower, more cinematic
    const animate = (el, delay, duration = 400) => {
      setTimeout(() => {
        el.style.transition = `opacity ${duration}ms ease-out`;
        el.style.opacity = '1';
      }, delay);
    };

    // 0ms - Question shrinks up
    animate(questionShrunk, 0, 300);

    // 300ms - UNNATURAL + INFORMATION appear together (as groups, opacity 1)
    setTimeout(() => {
      groupUnnatural.style.transition = 'opacity 500ms ease-out';
      groupUnnatural.style.opacity = '1';
      groupInformation.style.transition = 'opacity 500ms ease-out';
      groupInformation.style.opacity = '1';
      // But the because sentences inside are still opacity 0
    }, 300);

    // 1000ms - Words separate (add gap between groups)
    setTimeout(() => {
      title.style.transition = 'gap 600ms ease-out';
      title.style.gap = 'var(--space-10)';
    }, 1000);

    // 1800ms - First "because" fades in (under UNNATURAL)
    animate(because1, 1800, 500);

    // 2500ms - Second "because" fades in (under INFORMATION)
    animate(because2, 2500, 500);

    // 3200ms - Enter appears
    animate(enter, 3200, 400);
  }

  // Auto-reveal after progress completes (2.5s)
  setTimeout(reveal, 2500);

  // Skip on click or scroll
  document.addEventListener('click', reveal);
  document.addEventListener('scroll', reveal);
  document.addEventListener('keydown', reveal);

  // TODO: PostHog integration for A/B tracking of questions
  // window.posthog?.capture('landing_question_shown', { question });
</script>
