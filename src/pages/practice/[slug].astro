---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PracticeWorkbench from '../../components/PracticeWorkbench';
import { PRACTICES, ROUTES, gardenOutcome } from '../../lib/practices';
import { BREAD_FEEDBACK, BREAD_RESULTS, LABEL_VIEWS, MODE_PASSES, PATTERN_INSTRUCTIONS, WINDOW_CONTEXT } from '../../lib/practice-models';
import '../../styles/book.css';

export function getStaticPaths() { return PRACTICES.map(practice => ({ params: { slug: practice.slug }, props: { practice } })); }
const { practice } = Astro.props;
const chapters = (await getCollection('chapters', ({ data }) => !data.draft))
  .filter(c => (c.data.chapterNumber != null && practice.chapters.includes(c.data.chapterNumber)) || practice.framing?.includes(c.id))
  .sort((a, b) => a.data.order - b.data.order);
const gardenBaseline = gardenOutcome('open', 'volunteer', 'few', 'normal');
const gardenRota = gardenOutcome('open', 'shared', 'few', 'normal');
---
<BaseLayout title={practice.title} description={practice.question} cinematic>
  <SiteHeader />
  <main class="book-page" id="main-content">
    <p class="book-kicker"><a href="/practice">Small philosophical tests</a> · About {practice.minutes} minutes</p>
    <h1 class="book-title">{practice.title}</h1>
    <p class="book-lead">{practice.question}</p>
    <p class="book-copy">{practice.scene}</p>

    <section class="book-aside" aria-labelledby="concept-heading">
      <p class="book-kicker">The distinction under test</p>
      <h2 id="concept-heading">{practice.concept}</h2>
      <p>{practice.connection}</p>
    </section>

    <section class="book-section" aria-labelledby="steps-heading">
      <h2 id="steps-heading">Try it.</h2>
      <ol>{practice.steps.map(step => <li>{step}</li>)}</ol>
      <p class="book-small">Use the interactive page below, a sheet of paper, or only your attention. Nothing must be submitted.</p>
    </section>

    <PracticeWorkbench practice={practice} client:load />

    <noscript>
      <style is:inline>.practice-workbench { display: none; }</style>
      <div class="book-aside book-paper">
        <p><strong>JavaScript is off.</strong> The steps above still work. Use these paper details for the part the interactive model would otherwise provide.</p>

        {practice.slug === 'maps' && <>
          <h2>Three invented routes to the shop</h2>
          <table><caption>Information shown before the missing detail</caption><thead><tr><th>Route</th><th>Minutes</th><th>Cost</th></tr></thead><tbody>{ROUTES.map(route => <tr><th scope="row">{route.name}</th><td>{route.minutes}</td><td>{'$' + route.cost}</td></tr>)}</tbody></table>
          <details><summary>Open the omitted detail after predicting one</summary>
            <p>The {ROUTES.find(route => route.name === 'Footbridge')?.name} has {ROUTES.find(route => route.name === 'Footbridge')?.steps} steps. The other routes have no steps. A wheelchair, heavy trolley, fatigue, or injured knee can change which route is usable.</p>
            <p>Traffic, distance to the bus stop, reliability, weather, and safety remain outside this map.</p>
          </details>
        </>}

        {practice.slug === 'garden' && <>
          <h2>One invented season</h2>
          <p>Compare open access, volunteer maintenance, four organizers, and ordinary rainfall with the same garden using a shared rota. The other conditions stay the same.</p>
          <table><caption>An invented comparison</caption><thead><tr><th>Outcome</th><th>Volunteer work</th><th>Shared rota</th></tr></thead><tbody>
            <tr><th scope="row">Harvest units</th><td>{gardenBaseline.harvest}</td><td>{gardenRota.harvest}</td></tr>
            <tr><th scope="row">Work and meeting hours</th><td>{gardenBaseline.hours}</td><td>{gardenRota.hours}</td></tr>
            <tr><th scope="row">Households without access</th><td>{gardenBaseline.excluded}</td><td>{gardenRota.excluded}</td></tr>
            <tr><th scope="row">Households without a vote</th><td>{gardenBaseline.unheard}</td><td>{gardenRota.unheard}</td></tr>
          </tbody></table>
          <details><summary>Open the model assumptions</summary>
            <p>Water is {gardenBaseline.water} units, demand is {gardenBaseline.demand}, and meetings take {gardenBaseline.coordination} hour. Maintenance takes {gardenBaseline.maintenance} hours with volunteers or {gardenRota.maintenance} with a rota.</p>
            <p>Harvest is 0.6 × the smaller of water and demand, plus 3 × maintenance hours, minus 2 × meeting hours, rounded down. These chosen coefficients make shared work beneficial and participation costly in time. They are not findings about real gardens.</p>
            <p>Trust, ownership, unequal ability to contribute, missed work, and food distribution are absent. Harvest cannot settle fairness.</p>
          </details>
        </>}

        {practice.slug === 'experiment' && <>
          <h2>Three rounds after the same rise time</h2>
          <p>Original dough uses the original yeast, water temperature, and kneading. “All three changes” uses different yeast, warmer water, and longer kneading. “Yeast only” changes the yeast and keeps the other conditions the same.</p>
          <details><summary>After your prediction, open the results</summary>
          <table><caption>Invented increase in dough height, in centimetres</caption><thead><tr><th>Round</th><th>Original</th><th>All three changes</th><th>Yeast only</th></tr></thead><tbody>{BREAD_RESULTS.original.map((height, index) => <tr><th scope="row">{index + 1}</th><td>{height}</td><td>{BREAD_RESULTS.many[index]}</td><td>{BREAD_RESULTS.yeast[index]}</td></tr>)}</tbody></table>
          <p><strong>All three changes:</strong> {BREAD_FEEDBACK.many}</p>
          <p><strong>Yeast only:</strong> {BREAD_FEEDBACK.yeast}</p>
          </details>
        </>}

        {practice.slug === 'disagreement' && <>
          <h2>The shared context</h2>
          <details><summary>Open after giving both people a compatible reason</summary>{WINDOW_CONTEXT.map(paragraph => <p>{paragraph}</p>)}</details>
        </>}

        {practice.slug === 'labels' && <>
          <h2>Three descriptions of the same chipped cup</h2>
          {LABEL_VIEWS.map(view => <section><h3>{view.title}</h3><p>{view.question}</p></section>)}
        </>}

        {practice.slug === 'modes' && <>
          <h2>Three passes with one sheet</h2>
          {MODE_PASSES.map(pass => <section><h3>{pass.title} · {pass.verbs}</h3><ol>{pass.steps.map(step => <li>{step}</li>)}</ol></section>)}
        </>}

        {practice.slug === 'patterns' && <>
          <h2>Three instructions</h2>
          {PATTERN_INSTRUCTIONS.map(instruction => <section><h3>{instruction.title}</h3><p>{instruction.text}</p></section>)}
        </>}

        <details><summary>Questions to keep on paper</summary>
          <ol>{practice.fields.map(field => <li>{field.label}</li>)}</ol>
        </details>
        <p class="book-small">{practice.note}</p>
      </div>
    </noscript>

    <section class="book-section">
      <h2>Follow the distinction into the book.</h2>
      <ul>{chapters.map(chapter => <li><a href={'/chapters/' + chapter.id}>{chapter.data.chapterNumber ? chapter.data.chapterNumber + '. ' : ''}{chapter.data.title}</a></li>)}</ul>
      {practice.source && <p class="book-small" style="margin-top: 1.5rem">A source behind the idea: <a href={practice.source.url}>{practice.source.title}</a>. This exercise has not been validated as a measure of personal change.</p>}
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .book-aside h2 { font: 400 var(--text-2xl)/1.2 var(--font-display); margin: var(--space-2) 0 var(--space-3); }
  .book-section > ol, .book-paper ol { display: grid; gap: var(--space-3); padding-left: 1.35rem; }
  .book-paper h2 { font: 380 var(--text-xl)/1.2 var(--font-display); margin: var(--space-6) 0 var(--space-3); }
  .book-paper h3 { font: 500 var(--text-base)/1.3 var(--font-body); margin: var(--space-5) 0 var(--space-2); }
  .book-paper table { width: 100%; border-collapse: collapse; margin: var(--space-4) 0; font-size: var(--text-sm); }
  .book-paper caption { text-align: left; color: var(--color-ink-muted); margin-bottom: var(--space-2); }
  .book-paper th, .book-paper td { padding: .55rem .35rem; text-align: left; border-bottom: 1px solid var(--color-rule-soft); }
</style>
