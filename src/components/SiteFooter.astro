---
const year = new Date().getFullYear();
---
<footer class="sf">
  <div class="sf__inner">
    <div class="sf__glyph" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="sf__body">
      <p class="sf__title">UNNATURAL</p>
      <p class="sf__tagline">
        A philosophical book about ordinary lives in a shared world.
      </p>
      <p class="sf__thesis">
        <span>Read slowly. Keep what helps.</span>
        <span>Question the rest.</span>
      </p>
    </div>
    <nav class="sf__meta" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/explore">The book</a>
      <a href="/practice">Practice</a>
      <a href="/wiki/">Archive</a>
      <a href="/reading">Reading</a>
      <a href="/about">About</a>
    </nav>
  </div>

  <div class="sf__rule" aria-hidden="true"></div>

  <div class="sf__legal">
    <p class="sf__copyright">
      <span class="sf__copy-mark" aria-hidden="true">©</span>
      {year} <a href="https://sahil.pro" rel="noopener" class="sf__author">Sahil Dawka</a>. A living document.
    </p>
    <p class="sf__version">
      <span aria-hidden="true">v.</span>
      <span>working draft</span>
    </p>
  </div>
</footer>

<style>
  .sf { margin-top: var(--space-24); padding: var(--space-12) var(--safe-right) calc(var(--space-6) + var(--safe-bottom)) var(--safe-left); border-top: 1px solid var(--color-rule-soft); background: linear-gradient(160deg, color-mix(in srgb, var(--color-surface) 88%, transparent), var(--color-ground)); }
  .sf__inner { max-width: var(--page-max); margin: 0 auto; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--space-8); align-items: start; }
  .sf__glyph { display: inline-flex; flex-direction: column; gap: 5px; padding-top: .5em; }
  .sf__glyph span { display: block; height: 2px; border-radius: 1px; background: linear-gradient(90deg, var(--color-metal-high), var(--color-metal-low)); }
  .sf__glyph span:nth-child(1) { width: 32px; } .sf__glyph span:nth-child(2) { width: 20px; opacity: .6; } .sf__glyph span:nth-child(3) { width: 10px; opacity: .3; }
  .sf__body { max-width: 40ch; }
  .sf__title { font: 600 var(--text-lg)/1.2 var(--font-display); letter-spacing: .14em; }
  .sf__tagline { margin-top: var(--space-2); font: italic 360 var(--text-base)/1.5 var(--font-display); color: var(--color-ink-muted); }
  .sf__thesis { margin-top: var(--space-4); display: flex; flex-direction: column; gap: .1em; font: 500 .8125rem/1.5 var(--font-ui); color: var(--color-ink-muted); }
  .sf__meta { display: grid; grid-template-columns: repeat(2, auto); gap: var(--space-1) var(--space-3); font: 600 .8125rem/1 var(--font-ui); color: var(--color-ink-muted); }
  .sf__meta a { min-height: 44px; display: inline-flex; align-items: center; justify-content: flex-end; padding: 0 var(--space-2); border-radius: var(--radius-sm); }
  .sf__meta a:is(:hover, :focus-visible) { color: var(--color-ink); background: var(--color-surface-raised); }
  .sf__rule { max-width: var(--page-max); margin: var(--space-8) auto var(--space-5); height: 1px; background: linear-gradient(90deg, transparent, var(--color-rule), transparent); }
  .sf__legal { max-width: var(--page-max); margin: 0 auto; display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; font: 500 .8125rem/1.5 var(--font-ui); color: var(--color-ink-muted); }
  .sf__copy-mark { font-family: var(--font-display); margin-right: .1em; }
  .sf__author { color: var(--color-ink); border-bottom: 1px solid var(--color-rule); }
  .sf__version { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: .08em; text-transform: uppercase; }
  @media (max-width: 44rem) {
    .sf { padding-top: var(--space-10); margin-top: var(--space-16); }
    .sf__inner { grid-template-columns: auto minmax(0, 1fr); gap: var(--space-5); }
    .sf__meta { grid-column: 1 / -1; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--color-rule-soft); padding-top: var(--space-3); }
    .sf__meta a { justify-content: center; }
    .sf__legal { flex-direction: column; gap: var(--space-2); align-items: flex-start; }
  }
  @media (max-width: 23rem) { .sf__meta { grid-template-columns: repeat(2, 1fr); } }
</style>
