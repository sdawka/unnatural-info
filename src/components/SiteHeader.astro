---
const current = Astro.url.pathname;
const isActive = (prefix: string) => current === prefix || current.startsWith(prefix + '/');
const isBook = current === '/explore' || current.startsWith('/acts/') || current.startsWith('/chapters/');
---

<header class="sh">
  <div class="sh__bar">
    <a href="/" class="sh__logo" aria-label="UNNATURAL — home">
      <span class="sh__logo-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="sh__logo-text">UNNATURAL</span>
    </a>
    <nav class="sh__nav" aria-label="Main navigation">
      <a href="/explore" class:list={["sh__link", isBook && 'is-active']}>The book</a>
      <a href="/practice" class:list={["sh__link", isActive('/practice') && 'is-active']}>Practice</a>
      <a href="/reading" class:list={["sh__link", isActive('/reading') && 'is-active']}>Reading</a>
    </nav>
  </div>
</header>

<style>
  .sh { position: sticky; top: 0; z-index: 50; padding-top: var(--safe-top); background: color-mix(in srgb, var(--color-ground) 90%, transparent); backdrop-filter: blur(10px) saturate(120%); -webkit-backdrop-filter: blur(10px) saturate(120%); border-bottom: 1px solid var(--color-rule-soft); }
  .sh__bar { max-width: var(--page-max); margin: 0 auto; padding: var(--space-3) var(--safe-right) var(--space-3) var(--safe-left); display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); }
  .sh__logo { display: inline-flex; align-items: center; gap: var(--space-3); flex-shrink: 0; text-decoration: none; color: var(--color-ink); }
  .sh__logo-mark { display: inline-flex; flex-direction: column; gap: 3px; padding: 2px 0; }
  .sh__logo-mark span { display: block; height: 2px; border-radius: 1px; background: var(--color-ink); }
  .sh__logo-mark span:nth-child(1) { width: 20px; }
  .sh__logo-mark span:nth-child(2) { width: 14px; opacity: .5; }
  .sh__logo-mark span:nth-child(3) { width: 8px; opacity: .22; }
  .sh__logo-text { font-family: var(--font-display); font-variation-settings: 'opsz' 18, 'wght' 600, 'SOFT' 20; font-size: 1.0625rem; letter-spacing: .14em; text-transform: uppercase; }
  .sh__nav { display: flex; align-items: center; gap: var(--space-5); }
  .sh__link { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: var(--color-ink-muted); text-decoration: none; border-bottom: 1px solid transparent; padding: .3em 0; }
  .sh__link:hover, .sh__link.is-active { color: var(--color-ink); border-bottom-color: currentColor; }
  @media (max-width: 34rem) { .sh__bar { gap: var(--space-3); } .sh__logo-mark { display: none; } .sh__logo-text { font-size: .9rem; letter-spacing: .1em; } .sh__nav { gap: var(--space-3); } .sh__link { font-size: .68rem; letter-spacing: .06em; } }
</style>
