---
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (prefix: string) => current === prefix || current.startsWith(prefix + '/');
const isBook = current === '/explore' || current.startsWith('/acts/') || current.startsWith('/chapters/');
---

<header class="sh">
  <div class="sh__bar">
    <a href="/" class="sh__logo" aria-label="UNNATURAL — home">
      <span class="sh__logo-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="sh__logo-text">UNNATURAL</span>
    </a>
    <nav class="sh__nav" aria-label="Main navigation">
      <a href="/explore" class:list={["sh__link", isBook && 'is-active']} aria-current={isBook ? 'page' : undefined}>The book</a>
      <a href="/practice" class:list={["sh__link", isActive('/practice') && 'is-active']} aria-current={isActive('/practice') ? 'page' : undefined}>Practice</a>
      <a href="/reading" class:list={["sh__link", isActive('/reading') && 'is-active']} aria-current={isActive('/reading') ? 'page' : undefined}>Reading</a>
    </nav>
    <details class="sh__appearance metal-surface" data-appearance hidden>
      <summary class="metal-action" aria-label="Appearance"><span aria-hidden="true">◐</span><span>Appearance</span></summary>
      <div class="sh__appearance-panel">
        <label for="site-appearance">Reading surface</label>
        <select id="site-appearance" data-theme-select>
          <option value="dark">Dark</option>
          <option value="light">Light</option>
          <option value="system">System</option>
        </select>
        <p>Saved only in this browser when storage is available.</p>
      </div>
    </details>
  </div>
</header>

<script>
  const control = document.querySelector<HTMLElement>('[data-appearance]');
  const select = control?.querySelector<HTMLSelectElement>('[data-theme-select]');
  if (control && select) {
    const active = document.documentElement.dataset.theme;
    select.value = active === 'light' || active === 'system' ? active : 'dark';
    control.hidden = false;
    select.addEventListener('change', () => {
      const value = select.value;
      if (value !== 'dark' && value !== 'light' && value !== 'system') return;
      document.documentElement.dataset.theme = value;
      try { localStorage.setItem('unnatural:appearance', value); } catch { /* The control still works for this page. */ }
    });
    document.addEventListener('pointerdown', (event) => {
      if (control.hasAttribute('open') && !control.contains(event.target as Node)) control.removeAttribute('open');
    });
    control.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !control.hasAttribute('open')) return;
      control.removeAttribute('open');
      control.querySelector<HTMLElement>('summary')?.focus();
    });
  }
</script>

<style>
  .sh { position: sticky; top: 0; z-index: 50; padding-top: var(--safe-top); background: color-mix(in srgb, var(--color-ground) 88%, transparent); backdrop-filter: blur(16px) saturate(115%); border-bottom: 1px solid var(--color-rule-soft); }
  .sh__bar { max-width: var(--page-max); min-height: calc(var(--header-height) - var(--safe-top)); margin: 0 auto; padding: var(--space-2) var(--safe-right) var(--space-2) var(--safe-left); display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-6); }
  .sh__logo { display: inline-flex; min-height: 44px; align-items: center; gap: var(--space-3); color: var(--color-ink); }
  .sh__logo-mark { display: inline-flex; flex-direction: column; gap: 3px; padding: 2px 0; }
  .sh__logo-mark span { display: block; height: 2px; border-radius: 1px; background: linear-gradient(90deg, var(--color-metal-high), var(--color-metal-low)); }
  .sh__logo-mark span:nth-child(1) { width: 20px; } .sh__logo-mark span:nth-child(2) { width: 14px; opacity: .65; } .sh__logo-mark span:nth-child(3) { width: 8px; opacity: .35; }
  .sh__logo-text { font: 600 1rem/1 var(--font-display); letter-spacing: .14em; }
  .sh__nav { display: flex; justify-content: center; align-items: center; gap: var(--space-2); }
  .sh__link { min-height: 44px; display: inline-flex; align-items: center; padding: 0 var(--space-3); border-radius: var(--radius-sm); font: 600 .8125rem/1 var(--font-ui); color: var(--color-ink-muted); }
  .sh__link:is(:hover, :focus-visible), .sh__link.is-active { color: var(--color-ink); background: color-mix(in srgb, var(--color-surface-raised) 70%, transparent); }
  .sh__link.is-active::after { content: ''; position: absolute; left: var(--space-3); right: var(--space-3); bottom: 6px; height: 1px; background: linear-gradient(90deg, transparent, var(--color-metal-high), transparent); }
  .sh__appearance { position: relative; justify-self: end; border-radius: var(--radius-sm); box-shadow: none; }
  .sh__appearance[hidden] { display: none; }
  .sh__appearance > summary { list-style: none; min-height: var(--control-height); display: flex; align-items: center; gap: var(--space-2); padding: 0 var(--space-3); border-radius: var(--radius-sm); font: 600 .8125rem/1 var(--font-ui); color: var(--color-ink-soft); }
  .sh__appearance > summary::-webkit-details-marker { display: none; }
  .sh__appearance[open] > summary { background: var(--color-surface-raised); }
  .sh__appearance-panel { position: absolute; z-index: 3; right: 0; top: calc(100% + var(--space-2)); width: min(18rem, calc(100vw - 2 * var(--gutter))); padding: var(--space-4); border: 1px solid var(--color-rule); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: var(--shadow-panel); }
  .sh__appearance-panel label { display: block; margin-bottom: var(--space-2); font: 600 .875rem/1.3 var(--font-ui); }
  .sh__appearance-panel select { width: 100%; min-height: var(--control-height); padding: 0 var(--space-3); border: 1px solid var(--color-rule); border-radius: var(--radius-sm); background: var(--color-field); font-size: 1rem; }
  .sh__appearance-panel p { margin-top: var(--space-3); color: var(--color-ink-muted); font: 400 .8125rem/1.45 var(--font-ui); }
  @media (max-width: 40rem) {
    .sh__bar { grid-template-columns: 1fr auto; grid-template-rows: auto auto; gap: 0 var(--space-3); padding-block: var(--space-2); }
    .sh__nav { grid-column: 1 / -1; grid-row: 2; justify-content: stretch; border-top: 1px solid var(--color-rule-soft); }
    .sh__link { flex: 1; justify-content: center; }
    .sh__appearance { grid-column: 2; grid-row: 1; }
    .sh__appearance > summary span:last-child { display: none; }
    .sh__appearance > summary { width: var(--control-height); justify-content: center; padding: 0; }
  }
</style>
