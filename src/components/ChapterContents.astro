---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

const { headings } = Astro.props as { headings: Heading[] };
const links = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{links.length > 0 && (
  <details class="cc">
    <summary><span>In this chapter</span><small>{links.length} sections</small></summary>
    <nav aria-label="In this chapter">
      <ol>
        {links.map((heading) => (
          <li class:list={[heading.depth === 3 && 'cc__sub']}><a href={`#${heading.slug}`}>{heading.text}</a></li>
        ))}
      </ol>
    </nav>
  </details>
)}

<style>
  .cc { max-width: var(--prose-width); width: 100%; margin: 0 auto var(--space-6); border-block: 1px solid var(--color-rule-soft); }
  .cc summary { min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); list-style: none; font: 600 .8125rem/1.3 var(--font-ui); color: var(--color-ink-soft); }
  .cc summary::-webkit-details-marker { display: none; }
  .cc summary::before { content: '+'; width: 1em; color: var(--color-ink-muted); }
  .cc[open] summary::before { content: '−'; }
  .cc summary span { flex: 1; }
  .cc summary small { color: var(--color-ink-muted); font: 500 .8125rem/1.3 var(--font-ui); }
  .cc nav { padding: 0 0 var(--space-4) calc(1em + var(--space-3)); }
  .cc ol { list-style: none; display: grid; gap: var(--space-1); }
  .cc li { min-width: 0; }
  .cc li.cc__sub { padding-left: var(--space-4); }
  .cc a { min-height: 44px; display: flex; align-items: center; color: var(--color-ink-muted); font: 500 .875rem/1.35 var(--font-ui); }
  .cc a:is(:hover, :focus-visible) { color: var(--color-ink); }
  @media (max-width: 48rem) { .cc { margin-bottom: var(--space-3); } }
  @media (min-width: 64rem) { .cc { grid-column: 2; } }
</style>
