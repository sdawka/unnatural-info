---
interface Props {
  title: string;
  description?: string;
  cinematic?: boolean;
}

const {
  title,
  description = BOOK_DESCRIPTION,
  cinematic = false,
} = Astro.props;

const pageTitle = title === 'UNNATURAL' ? 'UNNATURAL' : `${title} — UNNATURAL`;

import '../styles/global.css';
import { BOOK_DESCRIPTION } from '../lib/book';
---

<!doctype html>
<html lang="en" class:list={[{ cinematic }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  .skip-link { position: fixed; top: .5rem; left: .5rem; z-index: 1000; padding: .7rem 1rem; background: var(--color-ink); color: var(--color-ground); transform: translateY(-200%); }
  .skip-link:focus { transform: translateY(0); }
</style>
