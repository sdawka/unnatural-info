---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ActBadge from '../components/ActBadge.astro';
import ChapterNav from '../components/ChapterNav.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ReaderControls from '../components/ReaderControls.astro';
import ChapterContents from '../components/ChapterContents.astro';
import { readingMinutes, draftLabel } from '../lib/book';
import { practicesForChapter } from '../lib/practices';
import references from '../data/references.json';
import '../styles/prose.css';

interface NavEntry {
  slug: string;
  title: string;
  chapterNumber?: number;
}

interface Props {
  chapter: CollectionEntry<'chapters'>;
  prev?: NavEntry;
  next?: NavEntry;
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { chapter, prev, next, headings = [] } = Astro.props;
const { title, subtitle, act, actTitle, chapterNumber, furtherReading } = chapter.data;
const practices = practicesForChapter(chapterNumber, chapter.id);
const referenceCount = references.filter(reference => reference.chapters.includes(chapter.id)).length;
---

<BaseLayout title={title} description={chapter.data.summary} cinematic>
  <ReadingProgress act={act} />
  <SiteHeader />
  <main class={`cp cp--${act}`} id="main-content" data-reading-chapter={chapter.id}>
    <div class="cp__container">
      <header class="cp__header">
        <div class="cp__meta">
          {act !== 'prologue' && act !== 'epilogue' && (
            <ActBadge act={act} actTitle={actTitle} />
          )}
          {chapterNumber ? (
            <span class="cp__num">
              <span class="cp__num-label">Ch.</span>
              <span class="cp__num-digit">{String(chapterNumber).padStart(2, '0')}</span>
            </span>
          ) : null}
        </div>

        <h1 class="cp__title">{title}</h1>
        {subtitle && <p class="cp__subtitle">{subtitle}</p>}
        <p class="cp__reading-time">{draftLabel(chapter.data.status)} · About {readingMinutes(chapter.body)} minutes to read · Practices optional</p>
        <div class="cp__reader-row">
          <a href="/explore" class="cp__book-link">Book contents <span aria-hidden="true">↗</span></a>
          <ReaderControls />
        </div>

        <div class="cp__rule" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
      </header>

      <ChapterContents headings={headings} />

      <article class="cp__body prose" data-reading-region>
        <slot />
      </article>

      <section class="cp__practice" aria-label="Reflection and optional practices">
        <details class="cp__recall">
          <summary>Pause before you turn the page</summary>
          <p>Look away from the text. How would you explain its main idea using a different example? Where might it fail? Then look back and see what you missed.</p>
        </details>
        {practices.length > 0 && <><h2 id="practice-heading">Try the idea.</h2><ul>{practices.map(practice => <li><a href={`/practice/${practice.slug}`}>{practice.title} <span>→</span></a><small>{practice.concept} · About {practice.minutes} minutes</small></li>)}</ul></>}
        <p>Your last chapter is remembered in this browser when storage is available. Personal exercise notes are saved only when you choose.</p>
      </section>

      {furtherReading && furtherReading.length > 0 && (
        <details class="fr">
          <summary class="fr__heading">
            <span class="glyph-stack" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
            Influences &amp; Further Reading
          </summary>
          <ol class="fr__list">
            {furtherReading.map((entry) => (
              <li class="fr__item">
                <div class="fr__line">
                  <span class="fr__author">{entry.author}</span>
                  <span class="fr__sep" aria-hidden="true">—</span>
                  <em class="fr__title">{entry.title}</em>
                  <span class="fr__year">({entry.year})</span>
                </div>
                <p class="fr__note">{entry.note}</p>
              </li>
            ))}
          </ol>
        </details>
      )}

      {referenceCount > 0 && <p class="fr__catalog"><a href={`/reading?chapter=${encodeURIComponent(chapter.id)}`}>Explore all {referenceCount} references connected to this chapter <span aria-hidden="true">→</span></a><span>Original and current sources, with notes on their place in the book.</span></p>}

      <ChapterNav prev={prev} next={next} />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const chapter = document.querySelector<HTMLElement>('[data-reading-chapter]')?.dataset.readingChapter;
  if (chapter) {
    try { localStorage.setItem('unnatural:last-chapter', chapter); } catch { /* Reading does not require storage. */ }
  }
</script>

<style>
  .cp__reading-time { font: 500 var(--text-sm)/1.5 var(--font-ui); color: var(--color-ink-muted); margin-top: var(--space-4); }
  .cp__reader-row { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
  .cp__book-link { min-height: 44px; display: inline-flex; align-items: center; gap: var(--space-2); font: 600 .8125rem/1 var(--font-ui); color: var(--color-ink-muted); border-bottom: 1px solid var(--color-rule); }
  .cp__book-link:hover { color: var(--color-ink); }
  .cp__practice { max-width: var(--prose-width); margin: var(--space-12) auto 0; padding-top: var(--space-6); border-top: 1px solid var(--color-rule); width: 100%; }
  .cp__practice h2 { font: 380 var(--text-2xl)/1.2 var(--font-display); margin: var(--space-6) 0 var(--space-4); }
  .cp__practice ul { list-style: none; padding: 0; }
  .cp__practice li { margin: var(--space-4) 0; }
  .cp__practice small { display: block; color: var(--color-ink-muted); font-size: var(--text-sm); }
  .cp__practice > p, .cp__recall p { font-size: var(--text-sm); color: var(--color-ink-muted); margin-top: var(--space-4); }
  .cp__recall summary, .fr__heading { cursor: pointer; min-height: 48px; align-items: center; }
  .fr__catalog { max-width: var(--prose-width); margin: var(--space-5) auto var(--space-8); font-size: var(--text-sm); }
  .fr__catalog a { text-decoration: underline; text-underline-offset: .2em; }
  .fr__catalog > span { display: block; margin-top: var(--space-2); color: var(--color-ink-muted); }
  .cp {
    padding: var(--space-12) var(--safe-right) var(--space-12) var(--safe-left);
  }

  .cp__container {
    max-width: var(--page-max);
    margin: 0 auto;
  }

  /* ——— Header ——— */
  .cp__header {
    max-width: var(--prose-width);
    margin: 0 auto var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 64rem) {
    .cp__header {
      margin-left: 0;
    }
  }

  .cp__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .cp__num {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-variation-settings: 'wght' 420;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cp__num-digit {
    color: var(--color-ink);
    font-size: 1.3em;
    letter-spacing: 0.05em;
  }

  .cp--volo-ergo-sum .cp__num-digit { color: var(--color-act-i); }
  .cp--initd .cp__num-digit        { color: var(--color-act-ii); }
  .cp--mmm .cp__num-digit          { color: var(--color-act-iii); }

  .cp__title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 128, 'wght' 310, 'SOFT' 60;
    font-size: var(--text-4xl);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .cp__title {
      font-size: var(--text-5xl);
    }
  }

  .cp__subtitle {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 36, 'wght' 350, 'SOFT' 40;
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    margin-top: var(--space-3);
    max-width: 36ch;
    text-wrap: pretty;
  }

  /* Three-bar rule */
  .cp__rule {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    margin-top: var(--space-6);
  }
  .cp__rule span {
    display: block;
    height: 2px;
    border-radius: 1px;
  }
  .cp--volo-ergo-sum .cp__rule span {
    background: var(--color-act-i);
  }
  .cp--initd .cp__rule span {
    background: var(--color-act-ii);
  }
  .cp--mmm .cp__rule span {
    background: var(--color-act-iii);
  }
  .cp--prologue .cp__rule span,
  .cp--epilogue .cp__rule span {
    background: var(--color-ink);
  }
  .cp__rule span:nth-child(1) { width: 40px; opacity: 1; }
  .cp__rule span:nth-child(2) { width: 24px; opacity: 0.6; }
  .cp__rule span:nth-child(3) { width: 12px; opacity: 0.3; }

  /* ——— Body ——— */
  .cp__body {
    margin: 0 auto;
  }

  @media (min-width: 64rem) {
    .cp__container {
      display: grid;
      grid-template-columns: 1fr minmax(0, var(--prose-width)) 1fr;
      align-items: start;
      column-gap: var(--space-8);
    }
    .cp__header {
      grid-column: 2;
      margin-left: 0;
    }
    .cp__body {
      grid-column: 2;
    }
    .fr, .fr__catalog, .cp__practice, nav.cn {
      grid-column: 2;
    }
  }

  /* ——— Further Reading ——— */
  .fr {
    max-width: var(--prose-width);
    margin: var(--space-20) auto 0;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-rule);
  }

  @media (min-width: 64rem) {
    .fr { margin-left: 0; }
  }

  .fr__heading {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-variation-settings: 'wght' 420;
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: var(--space-8);
  }

  .fr__heading .glyph-stack {
    color: var(--color-ink-faint);
  }

  .cp--volo-ergo-sum .fr__heading .glyph-stack { color: var(--color-act-i); }
  .cp--initd .fr__heading .glyph-stack        { color: var(--color-act-ii); }
  .cp--mmm .fr__heading .glyph-stack          { color: var(--color-act-iii); }

  .fr__list {
    list-style: none;
    padding: 0;
    counter-reset: fr;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .fr__item {
    counter-increment: fr;
    position: relative;
    padding-left: 2.8em;
  }

  .fr__item::before {
    content: counter(fr, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.2em;
    font-family: var(--font-mono);
    font-size: 0.7em;
    color: var(--color-ink-faint);
    letter-spacing: 0.08em;
  }

  .fr__line {
    font-size: var(--text-base);
    color: var(--color-ink);
    line-height: 1.45;
  }

  .fr__author {
    font-variation-settings: 'opsz' 12, 'wght' 560;
  }

  .fr__sep {
    color: var(--color-ink-faint);
    margin: 0 0.3em;
  }

  .fr__title {
    font-style: italic;
    color: var(--color-ink);
  }

  .fr__year {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.85em;
    margin-left: 0.4em;
  }

  .fr__note {
    margin-top: var(--space-2);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
    max-width: 62ch;
  }

  /* ——— Mobile tuning ——— */
  @media (max-width: 48rem) {
    .cp {
      padding: var(--space-5) var(--safe-right) var(--space-8) var(--safe-left);
    }
    .cp__header {
      gap: var(--space-2);
      margin-bottom: var(--space-3);
    }
    .cp__meta { margin-bottom: 0; }
    .cp__subtitle { margin-top: var(--space-1); }
    .cp__reading-time { margin-top: var(--space-2); }
    .cp__rule { margin-top: var(--space-3); }
  }
</style>
